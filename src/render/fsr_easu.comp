#version 450
/* FSR 1.0 EASU — Edge Adaptive Spatial Upsampling (clean implementation) */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly  image2D uInput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uOutput;
layout(push_constant) uniform PC {
    float inW, inH, scaleX, scaleY;
};

float lanczos2(float x) {
    x = abs(x); if (x < 1e-6) return 1.0; if (x >= 2.0) return 0.0;
    float px = 3.14159265359 * x;
    return (sin(px) * sin(px * 0.5)) / (px * px * 0.5);
}
float lum(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
    ivec2 oSz = imageSize(uOutput), iSz = imageSize(uInput);
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= oSz.x || pos.y >= oSz.y) return;

    float px = (float(pos.x) + 0.5) * scaleX - 0.5;
    float py = (float(pos.y) + 0.5) * scaleY - 0.5;
    int bx = int(floor(px)), by = int(floor(py));

    /* 4x4 neighbourhood with clamp */
    vec4 p[16];
    for (int j = -1; j <= 2; ++j) for (int i = -1; i <= 2; ++i) {
        ivec2 tc = clamp(ivec2(bx+i, by+j), ivec2(0), iSz - 1);
        p[(j+1)*4+(i+1)] = imageLoad(uInput, tc);
    }

    /* 3x3 Sobel luminance gradients */
    float l[9];
    for (int dj=0; dj<3; ++dj) for (int di=0; di<3; ++di)
        l[dj*3+di] = lum(p[(dj+1)*4+(di+1)]);

    float gx = (l[2]-l[0]) + 2.0*(l[5]-l[3]) + (l[8]-l[6]);
    float gy = (l[0]-l[6]) + 2.0*(l[1]-l[7]) + (l[2]-l[8]);
    float edgeLen = length(vec2(gx, gy)) + 1e-6;
    float ex = gx/edgeLen, ey = gy/edgeLen;
    float edgeStr = clamp(edgeLen * 0.25, 0.0, 1.0);

    /* Anisotropic Lanczos2 weighting */
    float sumW = 0.0; vec4 acc = vec4(0.0);
    for (int j = -1; j <= 2; ++j) for (int i = -1; i <= 2; ++i) {
        int idx = (j+1)*4+(i+1);
        float dx = float(bx+i)+0.5 - px;
        float dy = float(by+j)+0.5 - py;
        float dPara = dx*ex + dy*ey;
        float dPerp = dx*(-ey) + dy*ex;
        float stretch = 1.0 + 1.5 * edgeStr;
        float dist = sqrt(dPara*dPara + (dPerp*stretch)*(dPerp*stretch));
        float w = lanczos2(dist);
        sumW += w; acc += w * p[idx];
    }
    imageStore(uOutput, pos, (sumW > 1e-6) ? (acc / sumW) : vec4(0.0));
}
