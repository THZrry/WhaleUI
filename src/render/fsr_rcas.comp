#version 450
/* FSR 1.0 RCAS — contrast-adaptive sharpening (CPU-style unsharp-mask formula) */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly  image2D uInput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uOutput;
layout(push_constant) uniform PC {
    float sharpness;  // [0, 1] — same as CPU's fsr_rcas()
    float _pad0, _pad1, _pad2;
} params;

void main() {
    ivec2 imgSize = imageSize(uInput);
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= imgSize.x || pos.y >= imgSize.y) return;

    /* Read 3x3 neighbourhood */
    vec4 p[9];
    for (int j = -1; j <= 1; ++j) for (int i = -1; i <= 1; ++i)
        p[(j+1)*3+(i+1)] = imageLoad(uInput, clamp(pos+ivec2(i,j), ivec2(0), imgSize-1));

    vec4 centre = p[4];
    float scale = params.sharpness * 2.0;
    vec4 outC = centre;

    for (int c = 0; c < 3; ++c) {
        float n0 = p[1][c], n1 = p[3][c], n2 = p[5][c], n3 = p[7][c];
        float mn = min(min(n0, n1), min(n2, n3));
        float mx = max(max(n0, n1), max(n2, n3));
        float range = mx - mn;
        float cv = centre[c];

        if (range > 1e-6 && cv >= mn && cv <= mx) {
            float amount = 2.0 * (1.0 - max(range, 0.5));
            amount = clamp(amount * scale, 0.0, scale);
            outC[c] = cv + (cv - (n0+n1+n2+n3)*0.25) * amount;
        }
    }
    outC.a = centre.a;
    imageStore(uOutput, pos, clamp(outC, 0.0, 1.0));
}
